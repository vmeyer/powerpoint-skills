{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pptx change set",
  "type": "object",
  "required": ["ops"],
  "additionalProperties": false,
  "properties": {
    "label": {"type": "string"},
    "ops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "title": "add_slide",
            "type": "object",
            "required": ["op", "layout"],
            "additionalProperties": false,
            "properties": {
              "op": {"const": "add_slide"},
              "layout": {"type": "string", "minLength": 1},
              "after": {"$ref": "#/$defs/slide_ref"}
            }
          },
          {
            "title": "delete_slide",
            "type": "object",
            "required": ["op", "slide"],
            "additionalProperties": false,
            "properties": {
              "op": {"const": "delete_slide"},
              "slide": {"$ref": "#/$defs/slide_ref"}
            }
          },
          {
            "title": "move_slide",
            "type": "object",
            "required": ["op", "slide", "to"],
            "additionalProperties": false,
            "properties": {
              "op": {"const": "move_slide"},
              "slide": {"$ref": "#/$defs/slide_ref"},
              "to": {"type": "integer", "minimum": 1}
            }
          },
          {
            "title": "clone_slide",
            "type": "object",
            "required": ["op", "from"],
            "additionalProperties": false,
            "properties": {
              "op": {"const": "clone_slide"},
              "from": {"$ref": "#/$defs/source_slide"},
              "after": {"$ref": "#/$defs/slide_ref"}
            }
          },
          {
            "title": "replace_slide",
            "type": "object",
            "required": ["op", "slide", "from"],
            "additionalProperties": false,
            "properties": {
              "op": {"const": "replace_slide"},
              "slide": {"$ref": "#/$defs/slide_ref"},
              "from": {"$ref": "#/$defs/source_slide"}
            }
          },
          {
            "title": "set_text",
            "type": "object",
            "required": ["op", "slide", "target"],
            "additionalProperties": false,
            "oneOf": [{"required": ["text"]}, {"required": ["paragraphs"]}],
            "properties": {
              "op": {"const": "set_text"},
              "slide": {"$ref": "#/$defs/slide_ref"},
              "target": {"$ref": "#/$defs/target"},
              "text": {"type": "string"},
              "paragraphs": {"$ref": "#/$defs/paragraphs"},
              "font": {"$ref": "#/$defs/font"}
            }
          },
          {
            "title": "add_shape",
            "type": "object",
            "required": ["op", "slide", "name", "shape", "box"],
            "additionalProperties": false,
            "not": {"required": ["text", "paragraphs"]},
            "properties": {
              "op": {"const": "add_shape"},
              "slide": {"$ref": "#/$defs/slide_ref"},
              "name": {"type": "string", "minLength": 1},
              "shape": {"enum": ["rect", "roundRect", "homePlate", "chevron", "rightArrow", "leftArrow", "upArrow", "downArrow", "ellipse", "textbox"]},
              "box": {"$ref": "#/$defs/box"},
              "fill": {"type": "string"},
              "line": {"$ref": "#/$defs/shape_line"},
              "pattern": {"$ref": "#/$defs/pattern"},
              "text": {"type": "string"},
              "paragraphs": {"$ref": "#/$defs/paragraphs"},
              "font": {"$ref": "#/$defs/font"},
              "align": {"enum": ["left", "center", "right"]},
              "anchor": {"enum": ["top", "middle", "bottom"]},
              "insets": {"type": "array", "items": {"type": "number", "minimum": 0}, "minItems": 4, "maxItems": 4},
              "radius": {"type": "number", "minimum": 0, "maximum": 0.5},
              "rotation": {"type": "number", "minimum": 0, "exclusiveMaximum": 360},
              "allow_rgb": {"type": "boolean"}
            }
          },
          {
            "title": "add_table",
            "type": "object",
            "required": ["op", "slide", "name", "box", "rows"],
            "additionalProperties": false,
            "properties": {
              "op": {"const": "add_table"},
              "slide": {"$ref": "#/$defs/slide_ref"},
              "name": {"type": "string", "minLength": 1},
              "box": {"$ref": "#/$defs/box"},
              "rows": {"$ref": "#/$defs/table_rows"},
              "header": {"type": "boolean"},
              "style": {"type": "string", "minLength": 1},
              "col_widths": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}, "minItems": 1},
              "font": {"$ref": "#/$defs/font"},
              "fills": {"type": "object", "additionalProperties": false, "patternProperties": {"^[0-9]+,[0-9]+$": {"type": "string"}}},
              "allow_rgb": {"type": "boolean"}
            }
          },
          {
            "title": "set_table",
            "type": "object",
            "required": ["op", "slide", "target", "rows"],
            "additionalProperties": false,
            "properties": {
              "op": {"const": "set_table"},
              "slide": {"$ref": "#/$defs/slide_ref"},
              "target": {"$ref": "#/$defs/target"},
              "rows": {"$ref": "#/$defs/table_rows"},
              "font": {"$ref": "#/$defs/font"},
              "allow_rgb": {"type": "boolean"}
            }
          },
          {
            "title": "add_chart",
            "type": "object",
            "required": ["op", "slide", "name", "box", "type", "categories", "series"],
            "additionalProperties": false,
            "properties": {
              "op": {"const": "add_chart"},
              "slide": {"$ref": "#/$defs/slide_ref"},
              "name": {"type": "string", "minLength": 1},
              "box": {"$ref": "#/$defs/box"},
              "type": {"enum": ["column_clustered", "column_stacked", "bar_clustered", "bar_stacked", "line", "doughnut"]},
              "categories": {"type": "array", "items": {"type": "string"}, "minItems": 1},
              "series": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["name", "values"],
                  "additionalProperties": false,
                  "properties": {
                    "name": {"type": "string"},
                    "values": {"type": "array", "items": {"type": "number"}, "minItems": 1}
                  }
                }
              },
              "legend": {"enum": ["bottom", "right", "none"]},
              "labels": {"type": "boolean"}
            }
          },
          {
            "title": "add_picture",
            "type": "object",
            "required": ["op", "slide", "name", "path", "alt"],
            "additionalProperties": false,
            "oneOf": [{"required": ["box"]}, {"required": ["target"]}],
            "properties": {
              "op": {"const": "add_picture"},
              "slide": {"$ref": "#/$defs/slide_ref"},
              "name": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1},
              "box": {"$ref": "#/$defs/box"},
              "target": {"$ref": "#/$defs/target"},
              "alt": {"type": "string", "minLength": 1}
            }
          },
          {
            "title": "set_notes",
            "type": "object",
            "required": ["op", "slide", "text"],
            "additionalProperties": false,
            "properties": {
              "op": {"const": "set_notes"},
              "slide": {"$ref": "#/$defs/slide_ref"},
              "text": {"type": "string"}
            }
          },
          {
            "title": "add_line",
            "type": "object",
            "required": ["op", "slide", "name", "from", "to", "color", "width_pt"],
            "additionalProperties": false,
            "properties": {
              "op": {"const": "add_line"},
              "slide": {"$ref": "#/$defs/slide_ref"},
              "name": {"type": "string", "minLength": 1},
              "from": {"$ref": "#/$defs/point"},
              "to": {"$ref": "#/$defs/point"},
              "color": {"type": "string"},
              "width_pt": {"type": "number", "exclusiveMinimum": 0},
              "dash": {"type": "string"},
              "head": {"enum": ["none", "triangle", "arrow"]},
              "tail": {"enum": ["none", "triangle", "arrow"]},
              "allow_rgb": {"type": "boolean"}
            }
          },
          {
            "title": "update_shape",
            "type": "object",
            "required": ["op", "slide", "target"],
            "additionalProperties": false,
            "not": {"required": ["text", "paragraphs"]},
            "properties": {
              "op": {"const": "update_shape"},
              "slide": {"$ref": "#/$defs/slide_ref"},
              "target": {"$ref": "#/$defs/target"},
              "name": {"type": "string", "minLength": 1},
              "box": {"$ref": "#/$defs/box"},
              "fill": {"type": "string"},
              "line": {"$ref": "#/$defs/shape_line"},
              "pattern": {"$ref": "#/$defs/pattern"},
              "text": {"type": "string"},
              "paragraphs": {"$ref": "#/$defs/paragraphs"},
              "font": {"$ref": "#/$defs/font"},
              "align": {"enum": ["left", "center", "right"]},
              "anchor": {"enum": ["top", "middle", "bottom"]},
              "insets": {"type": "array", "items": {"type": "number", "minimum": 0}, "minItems": 4, "maxItems": 4},
              "radius": {"type": "number", "minimum": 0, "maximum": 0.5},
              "rotation": {"type": "number", "minimum": 0, "exclusiveMaximum": 360},
              "allow_rgb": {"type": "boolean"}
            }
          },
          {
            "title": "delete_shape",
            "type": "object",
            "required": ["op", "slide", "target"],
            "additionalProperties": false,
            "properties": {
              "op": {"const": "delete_shape"},
              "slide": {"$ref": "#/$defs/slide_ref"},
              "target": {"$ref": "#/$defs/target"}
            }
          },
          {
            "title": "z_order",
            "type": "object",
            "required": ["op", "slide", "target", "to"],
            "additionalProperties": false,
            "properties": {
              "op": {"const": "z_order"},
              "slide": {"$ref": "#/$defs/slide_ref"},
              "target": {"$ref": "#/$defs/target"},
              "to": {"enum": ["front", "back", "forward", "backward"]}
            }
          },
          {
            "title": "group",
            "type": "object",
            "required": ["op", "slide", "targets", "name"],
            "additionalProperties": false,
            "properties": {
              "op": {"const": "group"},
              "slide": {"$ref": "#/$defs/slide_ref"},
              "targets": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/target"}},
              "name": {"type": "string", "minLength": 1}
            }
          },
          {
            "title": "ungroup",
            "type": "object",
            "required": ["op", "slide", "target"],
            "additionalProperties": false,
            "properties": {
              "op": {"const": "ungroup"},
              "slide": {"$ref": "#/$defs/slide_ref"},
              "target": {"$ref": "#/$defs/target"}
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "paragraphs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["runs"],
        "additionalProperties": false,
        "properties": {
          "level": {"type": "integer", "minimum": 0, "maximum": 8},
          "bullet": {"type": "boolean"},
          "runs": {
            "type": "array",
            "items": {
              "type": "object",
              "anyOf": [{"required": ["t"]}, {"required": ["br"]}],
              "additionalProperties": false,
              "properties": {
                "t": {"type": "string"},
                "br": {"type": "boolean"},
                "b": {"type": "boolean"},
                "i": {"type": "boolean"},
                "color": {"type": "string"},
                "size": {"type": "number", "exclusiveMinimum": 0}
              }
            }
          }
        }
      }
    },
    "font": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": {"type": "number", "exclusiveMinimum": 0},
        "color": {"type": "string"},
        "bold": {"type": "boolean"}
      }
    },
    "box": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
    "table_rows": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"type": "string"}}},
    "point": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
    "shape_line": {
      "oneOf": [
        {"const": "none"},
        {
          "type": "object",
          "required": ["color"],
          "additionalProperties": false,
          "properties": {
            "color": {"type": "string"},
            "width_pt": {"type": "number", "exclusiveMinimum": 0},
            "dash": {"type": "string"}
          }
        }
      ]
    },
    "pattern": {
      "type": "object",
      "required": ["preset", "fg", "bg"],
      "additionalProperties": false,
      "properties": {"preset": {"type": "string"}, "fg": {"type": "string"}, "bg": {"type": "string"}}
    },
    "source_slide": {
      "type": "object",
      "required": ["deck", "slide"],
      "additionalProperties": false,
      "properties": {
        "deck": {"type": "string", "minLength": 1},
        "slide": {"$ref": "#/$defs/slide_ref"}
      }
    },
    "slide_ref": {
      "oneOf": [
        {"type": "integer", "minimum": 1},
        {"type": "string", "pattern": "^(id:[0-9]+|\\$last)$"}
      ]
    },
    "target": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "role": {"type": "string"},
        "name": {"type": "string"},
        "id": {"type": "integer"}
      }
    }
  }
}
