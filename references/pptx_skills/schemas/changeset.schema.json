{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pptx change set",
  "type": "object",
  "required": ["ops"],
  "additionalProperties": false,
  "properties": {
    "label": {"type": "string"},
    "ops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "title": "add_slide",
            "type": "object",
            "required": ["op", "layout"],
            "additionalProperties": false,
            "properties": {
              "op": {"const": "add_slide"},
              "layout": {"type": "string", "minLength": 1},
              "after": {"$ref": "#/$defs/slide_ref"}
            }
          },
          {
            "title": "delete_slide",
            "type": "object",
            "required": ["op", "slide"],
            "additionalProperties": false,
            "properties": {
              "op": {"const": "delete_slide"},
              "slide": {"$ref": "#/$defs/slide_ref"}
            }
          },
          {
            "title": "move_slide",
            "type": "object",
            "required": ["op", "slide", "to"],
            "additionalProperties": false,
            "properties": {
              "op": {"const": "move_slide"},
              "slide": {"$ref": "#/$defs/slide_ref"},
              "to": {"type": "integer", "minimum": 1}
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "slide_ref": {
      "oneOf": [
        {"type": "integer", "minimum": 1},
        {"type": "string", "pattern": "^(id:[0-9]+|\\$last)$"}
      ]
    },
    "target": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "role": {"type": "string"},
        "name": {"type": "string"},
        "id": {"type": "integer"}
      }
    }
  }
}
