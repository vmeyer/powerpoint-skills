{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pptx change set",
  "type": "object",
  "required": ["ops"],
  "additionalProperties": false,
  "properties": {
    "label": {"type": "string"},
    "ops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "title": "add_slide",
            "type": "object",
            "required": ["op", "layout"],
            "additionalProperties": false,
            "properties": {
              "op": {"const": "add_slide"},
              "layout": {"type": "string", "minLength": 1},
              "after": {"$ref": "#/$defs/slide_ref"}
            }
          },
          {
            "title": "delete_slide",
            "type": "object",
            "required": ["op", "slide"],
            "additionalProperties": false,
            "properties": {
              "op": {"const": "delete_slide"},
              "slide": {"$ref": "#/$defs/slide_ref"}
            }
          },
          {
            "title": "move_slide",
            "type": "object",
            "required": ["op", "slide", "to"],
            "additionalProperties": false,
            "properties": {
              "op": {"const": "move_slide"},
              "slide": {"$ref": "#/$defs/slide_ref"},
              "to": {"type": "integer", "minimum": 1}
            }
          },
          {
            "title": "set_text",
            "type": "object",
            "required": ["op", "slide", "target"],
            "additionalProperties": false,
            "oneOf": [{"required": ["text"]}, {"required": ["paragraphs"]}],
            "properties": {
              "op": {"const": "set_text"},
              "slide": {"$ref": "#/$defs/slide_ref"},
              "target": {"$ref": "#/$defs/target"},
              "text": {"type": "string"},
              "paragraphs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["runs"],
                  "additionalProperties": false,
                  "properties": {
                    "level": {"type": "integer", "minimum": 0, "maximum": 8},
                    "bullet": {"type": "boolean"},
                    "runs": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "anyOf": [{"required": ["t"]}, {"required": ["br"]}],
                        "additionalProperties": false,
                        "properties": {
                          "t": {"type": "string"},
                          "br": {"type": "boolean"},
                          "b": {"type": "boolean"},
                          "i": {"type": "boolean"},
                          "color": {"type": "string"},
                          "size": {"type": "number", "exclusiveMinimum": 0}
                        }
                      }
                    }
                  }
                }
              },
              "font": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "size": {"type": "number", "exclusiveMinimum": 0},
                  "color": {"type": "string"},
                  "bold": {"type": "boolean"}
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "slide_ref": {
      "oneOf": [
        {"type": "integer", "minimum": 1},
        {"type": "string", "pattern": "^(id:[0-9]+|\\$last)$"}
      ]
    },
    "target": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "role": {"type": "string"},
        "name": {"type": "string"},
        "id": {"type": "integer"}
      }
    }
  }
}
