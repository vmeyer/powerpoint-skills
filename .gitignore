.DS_Store
__pycache__/
.venv/
.pytest_cache/
.superpowers/

# Office files and decks are never committed: masters, example decks and
# working copies may be confidential. Test fixtures are generated at test time.
*.pptx
*.potx
*.pptm
*.ppt
*.odp
decks/

# Render output next to a corporate deck (e.g. <deck>-render/) and loose images in the
# repo root must never be committable either.
*-render/
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.webp
/*.pdf
